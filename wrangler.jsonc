// Static site on Cloudflare Workers (static assets only, no server code).
// `npm run deploy` builds site/ and uploads it. www redirects to the apex via redirect/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awesomeclef",
  "account_id": "cec5612170f2a2fbb96741bcaa29c36f",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "site"
  },
  "routes": [{ "pattern": "awesomeclef.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
